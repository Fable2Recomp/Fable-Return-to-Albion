# Project-wide line ending and whitespace normalization
# Ensures Git and editors treat line endings consistently (LF) across Windows and Linux.

# Default: treat all files as text and normalize to LF on checkout/commit
* text=auto eol=lf

# Explicit source code files: enforce LF line endings
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cs text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.lua text eol=lf
*.sh text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Godot engine and resource files
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.import text eol=lf
*.gd text eol=lf
*.gdshader text eol=lf
*.glsl text eol=lf
*.cfg text eol=lf

# Configuration, docs, and build metadata
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.csproj text eol=lf
*.sln text eol=lf

# Windows-specific batch scripts require CRLF to function properly
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: prevent Git from touching line endings
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.ctex binary
*.scn binary
*.zip binary
*.tar binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.lib binary
*.a binary
*.xex binary
*.xexp binary
*.bank binary
*.bnk binary
*.bik binary
*.glb binary
*.gltf binary

# Vendored thirdparty code: preserve original line endings untouched
**/thirdparty/** -text
**/dxc-bin/** -text
