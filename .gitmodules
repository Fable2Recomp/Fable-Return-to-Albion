[submodule "src/launcher/vendors/glfw"]
	path = src/launcher/vendors/glfw
	url = https://github.com/glfw/glfw.git
[submodule "src/launcher/vendors/imgui"]
	path = src/launcher/vendors/imgui
	url = https://github.com/ocornut/imgui.git
	branch = docking
[submodule "src/launcher/vendors/stb"]
	path = src/launcher/vendors/stb
	url = https://github.com/nothings/stb.git

[submodule "src/extractor/thirdparty/zlib"]
	path = src/extractor/thirdparty/zlib
	url = https://github.com/madler/zlib.git
[submodule "ReXGlue"]
	path = ReXGlue
	url = https://github.com/rexglue/rexglue-sdk.git
	branch = release/v0.8.0
