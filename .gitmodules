[submodule "src/renderer/thirdparty/plume/contrib/Vulkan-Headers"]
	path = src/renderer/thirdparty/plume/contrib/Vulkan-Headers
	url = https://github.com/KhronosGroup/Vulkan-Headers
[submodule "src/renderer/thirdparty/plume/contrib/D3D12MemoryAllocator"]
	path = src/renderer/thirdparty/plume/contrib/D3D12MemoryAllocator
	url = https://github.com/GPUOpen-LibrariesAndSDKs/D3D12MemoryAllocator
[submodule "rexglue-net/rexglue-sdk"]
