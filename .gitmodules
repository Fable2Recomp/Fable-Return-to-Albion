[submodule "src/renderer/thirdparty/renderdoc"]
	path = src/renderer/thirdparty/renderdoc
	url = https://github.com/baldurk/renderdoc
[submodule "src/renderer/thirdparty/plume/contrib/volk"]
	path = src/renderer/thirdparty/plume/contrib/volk
	url = https://github.com/zeux/volk
[submodule "src/renderer/thirdparty/plume/contrib/VulkanMemoryAllocator"]
	path = src/renderer/thirdparty/plume/contrib/VulkanMemoryAllocator
