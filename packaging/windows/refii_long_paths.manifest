<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Opt in to Win32 long paths (effective when the system policy
       LongPathsEnabled is set). Extracted Fable 2 asset paths reach ~194
       characters below the install root, so deep install prefixes can
       otherwise exceed MAX_PATH. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <ws2:longPathAware>true</ws2:longPathAware>
    </windowsSettings>
  </application>
</assembly>
