; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Fable 2 Launcher"
config/description="Rebuild of the refii launcher. Dependencies remain native DLLs."
run/main_scene="res://main.tscn"
config/project_settings_override="user://renderer.cfg"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/flush_stdout_on_print=true
config/icon="res://assets/launcher/icon.png"

[audio]

driver/mix_rate=48000

[autoload]

GameAssets="*res://src/Engine/Engine_GameAssets.cs"

[debug]

settings/profiler/max_timestamp_query_elements=4096
file_logging/enable_file_logging=true
file_logging/max_log_files=10

[display]

window/size/viewport_width=1280
window/size/viewport_height=760
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="refii-launcher"

[editor]

import/use_multiple_threads=false

[editor_plugins]

enabled=PackedStringArray("res://addons/bnk_mount/plugin.cfg", "res://addons/hud_editor/plugin.cfg")

[refii]

audio/voice_playback=false
banks/native_dir="res://../out/build/assetbrowser"
banks/game_data_root="res://../out/build/linux-amd64-debug/bin/assets/game/data"

[rendering]

rendering_device/staging_buffer/block_size_kb=1024
rendering_device/staging_buffer/max_size_mb=256
rendering_device/staging_buffer/texture_upload_region_size_px=128
rendering_device/d3d12/max_resource_descriptors=1000000
rendering_device/d3d12/max_sampler_descriptors=2048
rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
shader_compiler/shader_cache/strip_debug=true
viewport/hdr_2d=true
limits/global_shader_variables/buffer_size=262144
rendering_device/d3d12/max_resource_descriptors_per_frame=131072
rendering_device/d3d12/max_sampler_descriptors_per_frame=2048
rendering_device/d3d12/max_misc_descriptors_per_frame=2048

[shader_globals]

ui_keyboard_mode={
"type": "bool",
"value": false
}
fx_scene_depth={
"type": "sampler2D",
"value": ""
}
fx_scene_depth_valid={
"type": "float",
"value": 0.0
}
