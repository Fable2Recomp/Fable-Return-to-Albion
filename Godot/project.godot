; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Fable 2 Launcher"
config/description="Rebuild of the refii launcher. Dependencies remain native DLLs."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://assets/launcher/icon.png"

[audio]

driver/mix_rate=48000

[autoload]

GameAssets="*res://src/Engine/Engine_GameAssets.cs"

[debug]

; THE RUN LOG HAS TO SURVIVE THE RUN.
;
; Every diagnostic this project adds is read out of a pasted terminal buffer, and three runs
; in a row had their entity report cut off before it printed — so the measurement existed,
; cost a run each time, and was never seen. Godot writes the same stream to user://logs/
; here, which makes the tail readable no matter what the terminal kept.
file_logging/enable_file_logging=true
file_logging/max_log_files=10

[display]

window/size/viewport_width=1280
window/size/viewport_height=760

[dotnet]

project/assembly_name="refii-launcher"

[editor_plugins]

enabled=PackedStringArray("res://addons/bnk_mount/plugin.cfg")

[refii]

audio/voice_playback=false
banks/native_dir="res://../out/build/assetbrowser"
banks/game_data_root="res://../out/build/linux-amd64-debug/bin/assets/game/data"
