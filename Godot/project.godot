; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Fable 2 Launcher"
config/description="Rebuild of the refii launcher. Dependencies remain native DLLs."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/flush_stdout_on_print=true
config/icon="res://assets/launcher/icon.png"

[audio]

driver/mix_rate=48000

[autoload]

GameAssets="*res://src/Engine/Engine_GameAssets.cs"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=10

[display]

window/size/viewport_width=1280
window/size/viewport_height=760
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="refii-launcher"

[editor_plugins]

enabled=PackedStringArray("res://addons/bnk_mount/plugin.cfg", "res://addons/hud_editor/plugin.cfg")

[refii]

audio/voice_playback=false
banks/native_dir="res://../out/build/assetbrowser"
banks/game_data_root="res://../out/build/linux-amd64-debug/bin/assets/game/data"

[rendering]

limits/global_shader_variables/buffer_size=262144

; ARCHITECTURE-SCALE SHADOWS MUST READ AS ARCHITECTURE. The default 4096 directional map
; spread over the remaster's 450 m reach leaves a clocktower's silhouette a soft blob on the
; square below it — present, but not legible as a shadow of anything. 8192 with the higher
; filter puts a crisp edge on building shadows; the positional atlas doubles alongside so the
; budgeted lamp shadows share the gain.
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=8192

[shader_globals]

fx_scene_depth={
"type": "sampler2D",
"value": ""
}
fx_scene_depth_valid={
"type": "float",
"value": 0.0
}
atmos_inscatter={
"type": "sampler2D",
"value": ""
}
atmos_beta={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
atmos_sun={
"type": "vec3",
"value": Vector3(0, 0, 1)
}
atmos_close_fog={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
atmos_range={
"type": "vec4",
"value": Vector4(0, 2000, 1, 10)
}
atmos_curve={
"type": "vec3",
"value": Vector3(0, 0.0005, 1)
}
atmos_fog_on={
"type": "bool",
"value": false
}
atmos_factors={
"type": "vec2",
"value": Vector2(1, 1)
}
fable_light_debug={
"type": "int",
"value": 0
}
fable_bake_weight={
"type": "float",
"value": 1.0
}
fable_exposure_tex={
"type": "sampler2D",
"value": ""
}
fable_exposure_valid={
"type": "float",
"value": 0.0
}
fable_sky_ambient={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
fable_prop_lightmaps={
"type": "sampler2D",
"value": ""
}
