<Project Sdk="Godot.NET.Sdk/4.7.1">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- .NET 8 OR NEWER. The tests are built for 8 and run on it when it is installed; on a
         machine that only has a later runtime they roll forward to that one instead of the
         test host refusing to start and failing the build gate. -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath Condition="Exists('$(MSBuildThisFileDirectory)test.runsettings')">$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
    <RunSettingsFilePath Condition="'$(GODOT_BIN)' == '' and Exists('$(MSBuildThisFileDirectory)test.local.runsettings')">$(MSBuildThisFileDirectory)test.local.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc5" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\refii-launcher.csproj" />
  </ItemGroup>

  <!-- Engine_Hash's ARM path on any machine (Engine_HashArmTests): the same source a second time,
       in a namespace whose ARM instruction classes are the architecture manual's pseudocode. -->
  <Target Name="HashArmModelSource" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <HashArmModelText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../src/Engine/core/Engine_Hash.cs').Replace('namespace Refii.Core;', 'namespace Refii.Tests.ShaModel;'))</HashArmModelText>
      <HashArmModelFile>$(IntermediateOutputPath)Engine_Hash.ArmModel.cs</HashArmModelFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(HashArmModelFile)" Lines="$([MSBuild]::Escape($(HashArmModelText)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(HashArmModelFile)" />
    </ItemGroup>
  </Target>

</Project>
