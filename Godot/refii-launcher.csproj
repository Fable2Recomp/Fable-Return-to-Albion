<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Android export uses the supported Mono runtime pack; desktop remains .NET 8. -->
    <TargetFramework Condition="'$(GodotTargetPlatform)' == 'android'">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Refii.Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>refii-launcher</AssemblyName>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <!-- CA2255: refii-launcher is the dynamically loaded Godot host application assembly
         (EnableDynamicLoading=true emits a DLL), where [ModuleInitializer] is intentionally
         used to register title descriptors at assembly load time. -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>

    <!--
      THE ROSLYN BUILD SERVER HANGS AN AUTOMATED PACKAGE BUILD.

      Godot's export runs `dotnet publish`, which starts VBCSCompiler as a persistent daemon.
      The daemon inherits the build's stdout pipe and then idles waiting for more work, so
      ninja's poll never sees EOF: the package was written and zipped at 19:28 and ninja was
      still sitting in do_sys_poll ten minutes later with a zombie `sh` for a child. Nothing
      was compiling; the build simply could not tell it had finished.

      Off ONLY when the driver asks for it, so an interactive build keeps the warm server and
      its speed. `~/.cache/refii-scratch/run.sh` sets the variable.
    -->
    <UseSharedCompilation Condition="'$(REFII_NO_SHARED_COMPILATION)' == '1'">false</UseSharedCompilation>

    <!--
      Workstation, concurrent GC: pause LENGTH is what costs guest steps. Server GC shortens the
      walk but makes collections rare and long (longest pause 148 ms vs 50-65 ms), so it stays
      off; background gen-2 collection keeps the large walks off the frame thread. Re-measure
      without a rebuild via `DOTNET_gcServer=1` (optionally `DOTNET_GCHeapCount`).
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- The Android export's NativeAOT build (opt-in): src/android/Android.targets. -->
  <Import Project="src/android/Android.targets" />

  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>

  <!-- Auto-run tests during C# compilation: fail build on test error.

       NOT DURING AN EXPORT. The test project references this one, so running it from inside
       Godot's ExportDebug/ExportRelease publish rebuilds this assembly a second time, in the same
       output folders and without the export's runtime identifier, while the publish is still in
       flight. The export then finishes with no .NET assemblies embedded and the game stops at
       ".NET assemblies not found". The gate belongs to the editor/dev build. -->
  <!-- The Godot runtime the tests marked [RequireGodotRuntime] run in: GODOT_BIN from the
       environment, else the pinned editor the build fetches into tools/godot
       (cmake/refii_fetch_godot.cmake). Without one GdUnit4 refuses the whole run. -->
  <ItemGroup>
    <RefiiPinnedGodot Include="$(MSBuildThisFileDirectory)../tools/godot/Godot_v*_mono_linux.x86_64" />
    <RefiiPinnedGodot Include="$(MSBuildThisFileDirectory)../tools/godot/Godot_v*_mono_win64_console.exe" />
    <RefiiBuildCacheSources Include="$(MSBuildThisFileDirectory)../tools/build_cache/*.cs" />
    <RefiiBuildCacheSources Include="$(MSBuildThisFileDirectory)../tools/build_cache/Refii.BuildCache.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <RefiiBuildCacheOutDir>$(MSBuildThisFileDirectory)../out/cache/build-tool/bin</RefiiBuildCacheOutDir>
    <RefiiBuildCacheDll>$(RefiiBuildCacheOutDir)/Refii.BuildCache.dll</RefiiBuildCacheDll>
  </PropertyGroup>
  <Target Name="EnsureRefiiBuildCacheTool"
          Inputs="@(RefiiBuildCacheSources)"
          Outputs="$(RefiiBuildCacheDll)">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)../tools/build_cache/Refii.BuildCache.csproj&quot; -c Release -o &quot;$(RefiiBuildCacheOutDir)&quot; --nologo -v q"
          StandardOutputImportance="Normal"
          StandardErrorImportance="High" />
  </Target>
  <Target Name="RunTestsAfterBuild"
          AfterTargets="Build"
          DependsOnTargets="EnsureRefiiBuildCacheTool"
          Condition="'$(REFII_NO_TESTS)' != '1' and '$(IsTesting)' != 'true' and '$(VSTestSessionCorrelationId)' == '' and '$(Configuration)' != 'ExportDebug' and '$(Configuration)' != 'ExportRelease'">
    <PropertyGroup>
      <RefiiGodotBin Condition="'$(GODOT_BIN)' != ''">$(GODOT_BIN)</RefiiGodotBin>
      <RefiiGodotBin Condition="'$(RefiiGodotBin)' == ''">@(RefiiPinnedGodot->'%(FullPath)')</RefiiGodotBin>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(RefiiBuildCacheDll)&quot; test-gate --repo-root &quot;$(MSBuildThisFileDirectory)..&quot; --project-dir &quot;$(MSBuildThisFileDirectory).&quot; --test-csproj &quot;$(MSBuildThisFileDirectory)tests/Refii.Tests/Refii.Tests.csproj&quot; --config &quot;$(Configuration)&quot; --godot-bin &quot;$(RefiiGodotBin)&quot;"
          EnvironmentVariables="GODOT_BIN=$(RefiiGodotBin);REFII_NO_TESTS=1"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>
</Project>
