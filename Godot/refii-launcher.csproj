<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Refii.Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>refii-launcher</AssemblyName>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>

    <!--
      THE ROSLYN BUILD SERVER HANGS AN AUTOMATED PACKAGE BUILD.

      Godot's export runs `dotnet publish`, which starts VBCSCompiler as a persistent daemon.
      The daemon inherits the build's stdout pipe and then idles waiting for more work, so
      ninja's poll never sees EOF: the package was written and zipped at 19:28 and ninja was
      still sitting in do_sys_poll ten minutes later with a zombie `sh` for a child. Nothing
      was compiling; the build simply could not tell it had finished.

      Off ONLY when the driver asks for it, so an interactive build keeps the warm server and
      its speed. `~/.cache/refii-scratch/run.sh` sets the variable.
    -->
    <UseSharedCompilation Condition="'$(REFII_NO_SHARED_COMPILATION)' == '1'">false</UseSharedCompilation>

    <!--
      Workstation, concurrent GC: pause LENGTH is what costs guest steps. Server GC shortens the
      walk but makes collections rare and long (longest pause 148 ms vs 50-65 ms), so it stays
      off; background gen-2 collection keeps the large walks off the frame thread. Re-measure
      without a rebuild via `DOTNET_gcServer=1` (optionally `DOTNET_GCHeapCount`).
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>

  <!-- Auto-run tests during C# compilation: fail build on test error -->
  <Target Name="RunTestsAfterBuild" AfterTargets="Build" Condition="'$(REFII_NO_TESTS)' != '1' and '$(IsTesting)' != 'true'">
    <Message Importance="high" Text="================= [RUNNING UNIT TESTS] =================" />
    <Exec Command="dotnet test &quot;$(MSBuildThisFileDirectory)tests\Refii.Tests\Refii.Tests.csproj&quot; -c $(Configuration) -p:IsTesting=true -p:REFII_NO_TESTS=1 --logger &quot;console;verbosity=minimal&quot;"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
    <Message Importance="high" Text="========================================================" />
  </Target>
</Project>
