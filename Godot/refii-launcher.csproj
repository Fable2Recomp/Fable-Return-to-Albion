<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Android export uses the supported Mono runtime pack; desktop remains .NET 8. -->
    <TargetFramework Condition="'$(GodotTargetPlatform)' == 'android'">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Refii.Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>refii-launcher</AssemblyName>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>

    <!--
      THE ROSLYN BUILD SERVER HANGS AN AUTOMATED PACKAGE BUILD.

      Godot's export runs `dotnet publish`, which starts VBCSCompiler as a persistent daemon.
      The daemon inherits the build's stdout pipe and then idles waiting for more work, so
      ninja's poll never sees EOF: the package was written and zipped at 19:28 and ninja was
      still sitting in do_sys_poll ten minutes later with a zombie `sh` for a child. Nothing
      was compiling; the build simply could not tell it had finished.

      Off ONLY when the driver asks for it, so an interactive build keeps the warm server and
      its speed. `~/.cache/refii-scratch/run.sh` sets the variable.
    -->
    <UseSharedCompilation Condition="'$(REFII_NO_SHARED_COMPILATION)' == '1'">false</UseSharedCompilation>

    <!--
      Workstation, concurrent GC: pause LENGTH is what costs guest steps. Server GC shortens the
      walk but makes collections rare and long (longest pause 148 ms vs 50-65 ms), so it stays
      off; background gen-2 collection keeps the large walks off the frame thread. Re-measure
      without a rebuild via `DOTNET_gcServer=1` (optionally `DOTNET_GCHeapCount`).
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!--
    ANDROID NATIVEAOT (opt-in through the exporter's nativeaot flag).

    Godot's `dotnet/android_use_linux_bionic` export option publishes for linux-bionic-arm64
    instead of android-arm64. Godot.NET.Sdk's Android.props then still selects the Mono runtime
    (it only checks PublishAot, and runs before this file), so the switch to NativeAOT is made
    here: the publish produces one native `refii-launcher.so` that Godot's Android template
    dlopens as `librefii-launcher.so` and enters through `godotsharp_game_main_init` when no
    libmonosgen is packaged. The default android-arm64 (Mono) export is untouched.

    - PublishAotUsingRuntimePack / DisableUnsupportedError: linux-bionic is a community NativeAOT
      target in .NET 9; the ILCompiler and runtime come from the bionic runtime packs.
    - The game assembly and GodotSharp are trimmer roots, as in Godot's own iOS NativeAOT
      setup: Godot finds script classes and their members through reflection, and the game
      serializes its own types with reflection-based System.Text.Json.
    - InvariantGlobalization: a bionic process cannot load the platform ICU; the game parses
      and formats with the invariant culture already.
    - The split debug symbols (about 100 MB) stay out of the publish directory, whose every file
      Godot packages (a file that is not a .so lands in the APK's assets). They remain beside the
      native output in .godot/mono/temp/bin/(config)/linux-bionic-arm64/native/, where the
      exporter collects them for symbolizing device profiles.
    - The link step needs the NDK's clang on PATH (the exporter adds it).
  -->
  <PropertyGroup Condition="'$(GodotTargetPlatform)' == 'android' and $(RuntimeIdentifier.StartsWith('linux-bionic'))">
    <PublishAot>true</PublishAot>
    <UseMonoRuntime>false</UseMonoRuntime>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <DisableUnsupportedError>true</DisableUnsupportedError>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup Condition="'$(GodotTargetPlatform)' == 'android' and $(RuntimeIdentifier.StartsWith('linux-bionic'))">
    <TrimmerRootAssembly Include="GodotSharp" />
    <TrimmerRootAssembly Include="$(TargetName)" />
    <!--
      android_dotnet_gc: a C constructor that sets DOTNET_ GC variables from refii.toml when Godot
      loads the library, before the runtime starts and reads them (see the file). The NDK clang
      that links the library compiles it, with the link's own target.
    -->
    <NativeLibrary Include="$(MSBuildProjectDirectory)/src/android/native/refii_gc_preinit.c" />
  </ItemGroup>

  <!--
    Shape the library like every other APK library. The ILCompiler links a Unix shared library
    with RUNPATH $ORIGIN and no SONAME; Android's loader finds APK libraries by name in the app's
    own namespace, and the APK audit requires exactly one SONAME equal to the packaged file name
    (Godot adds the lib prefix when packaging) and no RPATH/RUNPATH.

    The .NET 9 ILCompiler also passes the runtime archives and the export version script to the
    linker unquoted, so a path with a space (this checkout's "Fable 2 Remake", a NuGet cache
    under it) splits into several arguments. Every argument with a space and no quote is quoted
    whole, in place, keeping the linker's argument order.
  -->
  <Target Name="RefiiBionicLibraryShape" AfterTargets="SetupOSSpecificProps"
          Condition="'$(PublishAot)' == 'true' and $(RuntimeIdentifier.StartsWith('linux-bionic'))">
    <ItemGroup>
      <LinkerArg Remove="-Wl,-rpath,'$(IlcRPath)'" />
      <LinkerArg Include="-Wl,-soname,lib$(TargetName)$(NativeBinaryExt)" />
    </ItemGroup>
  </Target>
  <!--
    The export version script (which keeps godotsharp_game_main_init exported) is passed as
    -Wl,-version-script=PATH inside the link target itself, past any LinkerArg fix-up, so its
    path is made relative to the project directory, where both ILC and the linker run.
  -->
  <Target Name="RefiiBionicRelativeExportsFile" BeforeTargets="WriteIlcRspFileForCompilation"
          Condition="'$(PublishAot)' == 'true' and $(RuntimeIdentifier.StartsWith('linux-bionic'))">
    <PropertyGroup>
      <ExportsFile>$([MSBuild]::MakeRelative($(MSBuildProjectDirectory), $(NativeIntermediateOutputPath)).Replace('\', '/'))$(TargetName)$(ExportsFileExt)</ExportsFile>
    </PropertyGroup>
  </Target>
  <!-- One batch per argument, in order. -->
  <Target Name="RefiiBionicQuoteLinkerArg" AfterTargets="RefiiBionicLibraryShape" Outputs="%(LinkerArg.Identity)"
          Condition="'$(PublishAot)' == 'true' and $(RuntimeIdentifier.StartsWith('linux-bionic'))">
    <PropertyGroup>
      <_RefiiLinkerArg>@(LinkerArg)</_RefiiLinkerArg>
      <_RefiiLinkerArg Condition="$(_RefiiLinkerArg.Contains(' ')) and !$(_RefiiLinkerArg.Contains('&quot;'))">&quot;$(_RefiiLinkerArg)&quot;</_RefiiLinkerArg>
    </PropertyGroup>
    <ItemGroup>
      <_RefiiQuotedLinkerArg Include="$(_RefiiLinkerArg)" />
    </ItemGroup>
  </Target>
  <Target Name="RefiiBionicUseQuotedLinkerArgs" AfterTargets="RefiiBionicQuoteLinkerArg"
          Condition="'$(PublishAot)' == 'true' and $(RuntimeIdentifier.StartsWith('linux-bionic'))">
    <ItemGroup>
      <LinkerArg Remove="@(LinkerArg)" />
      <LinkerArg Include="@(_RefiiQuotedLinkerArg)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>

  <!-- Auto-run tests during C# compilation: fail build on test error.

       NOT DURING AN EXPORT. The test project references this one, so running it from inside
       Godot's ExportDebug/ExportRelease publish rebuilds this assembly a second time, in the same
       output folders and without the export's runtime identifier, while the publish is still in
       flight. The export then finishes with no .NET assemblies embedded and the game stops at
       ".NET assemblies not found". The gate belongs to the editor/dev build. -->
  <Target Name="RunTestsAfterBuild" AfterTargets="Build" Condition="'$(REFII_NO_TESTS)' != '1' and '$(IsTesting)' != 'true' and '$(Configuration)' != 'ExportDebug' and '$(Configuration)' != 'ExportRelease'">
    <Message Importance="high" Text="================= [RUNNING UNIT TESTS] =================" />
    <Exec Command="dotnet test &quot;$(MSBuildThisFileDirectory)tests\Refii.Tests\Refii.Tests.csproj&quot; -c $(Configuration) -p:IsTesting=true -p:REFII_NO_TESTS=1 --logger &quot;console;verbosity=minimal&quot;"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
    <Message Importance="high" Text="========================================================" />
  </Target>
</Project>
