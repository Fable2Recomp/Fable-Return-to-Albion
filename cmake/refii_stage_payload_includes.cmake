# Copies the payload's include directories onto the shipped app.
#
# Run as a script (cmake -P) from the refii_payload_sdk staging target.
#   MANIFEST     file listing one include directory per line
#   DESTINATION  the staged recompile/ directory
#
# Each directory is staged verbatim under include/NN, numbered so that the compiler sees
# them in the same order on the player's machine as it does here. Headers only: an include
# directory may also hold sources, build output or an entire checkout, none of which the
# payload needs.

cmake_minimum_required(VERSION 3.24)

if(NOT MANIFEST OR NOT EXISTS "${MANIFEST}")
    message(FATAL_ERROR "MANIFEST must point at the generated include directory list")
endif()

if(NOT DESTINATION)
    message(FATAL_ERROR "DESTINATION must be set")
endif()

file(STRINGS "${MANIFEST}" _directories)

set(_include_root "${DESTINATION}/include")
file(REMOVE_RECURSE "${_include_root}")
file(MAKE_DIRECTORY "${_include_root}")

set(_index 0)
set(_staged "")

foreach(_directory IN LISTS _directories)
    if(_directory STREQUAL "" OR NOT IS_DIRECTORY "${_directory}")
        continue()
    endif()

    # refii's own trees are include dirs of the dev target and none of them belongs here.
    # The payload's translation units include exactly two things — the generated header,
    # which the player's machine produces and passes as GENERATED_DIR, and the rex headers.
    # refii's own headers reach the payload through the prebuilt hook archive, already
    # compiled, so staging them ships 4806 headers (150 MB) that nothing can include.
    if(SOURCE_ROOT AND
       (_directory STREQUAL "${SOURCE_ROOT}" OR _directory STREQUAL "${SOURCE_ROOT}/src"))
        continue()
    endif()

    if(GENERATED_ROOT AND _directory STREQUAL "${GENERATED_ROOT}")
        continue()
    endif()

    file(GLOB_RECURSE _headers RELATIVE "${_directory}"
        "${_directory}/*.h" "${_directory}/*.hpp" "${_directory}/*.hh"
        "${_directory}/*.inc" "${_directory}/*.inl" "${_directory}/*.ipp")

    if(NOT _headers)
        continue()
    endif()

    string(REPLACE "-" "" _padded "${_index}")
    if(_index LESS 10)
        set(_padded "0${_index}")
    else()
        set(_padded "${_index}")
    endif()

    set(_target_dir "${_include_root}/${_padded}")

    foreach(_header IN LISTS _headers)
        get_filename_component(_parent "${_header}" DIRECTORY)
        file(COPY "${_directory}/${_header}" DESTINATION "${_target_dir}/${_parent}")
    endforeach()

    list(LENGTH _headers _header_count)
    message(STATUS "Payload includes: ${_padded} <- ${_directory} (${_header_count} headers)")

    list(APPEND _staged "\${CMAKE_CURRENT_LIST_DIR}/include/${_padded}")
    math(EXPR _index "${_index} + 1")
endforeach()

set(_body "# Generated by refii_stage_payload_includes.cmake - DO NOT EDIT\nset(REFII_PAYLOAD_INCLUDE_DIRS\n")
foreach(_entry IN LISTS _staged)
    string(APPEND _body "    ${_entry}\n")
endforeach()
string(APPEND _body ")\n")

file(WRITE "${DESTINATION}/include_dirs.cmake" "${_body}")
message(STATUS "Payload includes: ${_index} directories staged")
