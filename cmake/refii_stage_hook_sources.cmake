# Stages the hook SOURCES for the install-time payload build.
#
# THE HOOKS CANNOT SHIP AS AN ARCHIVE. They are strong PPC overrides linked INTO the payload,
# and the payload is compiled on the player's machine by Zig. A librefii_hooks.a built here
# is built by our compiler: on Windows that is MSVC, whose C++ objects reference CRT
# internals a MinGW-built payload does not have, so the link cannot succeed no matter how
# few symbols cross. Shipping the sources and compiling them beside the generated code makes
# the whole payload one compiler's output.
#
# These are OUR sources, not game-derived, so shipping them is unrestricted — unlike the
# recompiled code they link against.
#
# Emits hook_sources.cmake in the same `set(VAR ...)` form the generator uses for
# sources.cmake, so the launcher reads both with one parser.

include_guard(GLOBAL)

function(refii_stage_hook_sources target destination source_root)
    if(NOT TARGET "${target}")
        return()
    endif()

    get_target_property(_sources "${target}" SOURCES)
    if(NOT _sources)
        return()
    endif()

    file(REMOVE_RECURSE "${destination}/hooks")
    set(_staged "")

    foreach(_source IN LISTS _sources)
        if(NOT IS_ABSOLUTE "${_source}")
            continue()
        endif()
        if(NOT _source MATCHES "\\.(cpp|cc|c)$")
            continue()
        endif()
        if(NOT EXISTS "${_source}")
            continue()
        endif()

        # Laid out under hooks/ by their path relative to src/, so a #include of a sibling
        # by relative path still resolves after staging.
        file(RELATIVE_PATH _relative "${source_root}/src" "${_source}")
        if(_relative MATCHES "^\\.\\.")
            get_filename_component(_relative "${_source}" NAME)
        endif()

        configure_file("${_source}" "${destination}/hooks/${_relative}" COPYONLY)
        list(APPEND _staged "\${CMAKE_CURRENT_LIST_DIR}/hooks/${_relative}")
    endforeach()

    list(LENGTH _staged _count)
    if(_count EQUAL 0)
        return()
    endif()

    list(JOIN _staged "\n    " _body)
    file(WRITE "${destination}/hook_sources.cmake"
         "# Generated by refii_stage_hook_sources.cmake - DO NOT EDIT\nset(REFII_HOOK_SOURCES\n    ${_body}\n)\n")

    message(STATUS "Staged ${_count} hook sources for the install-time payload build")
endfunction()
