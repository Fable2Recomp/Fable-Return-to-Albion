# Writes refii_build_id.h: the commit the host was built from, for the crash record.
#
# Run in script mode at BUILD time (see the refii_build_id target), not at configure time, so a
# build over a newer checkout stamps the newer commit. The header is rewritten only when its
# content changes, so an unchanged tree does not recompile refii_host.
#
#   cmake -DREFII_SOURCE_DIR=<tree> -DREFII_OUTPUT=<path>/refii_build_id.h -P refii_build_id.cmake
#
# The id is "<short sha><+ when the tree has uncommitted changes> <commit date>", or "unknown"
# when git or the repository is absent (a source archive, a machine without git).
if(NOT REFII_SOURCE_DIR OR NOT REFII_OUTPUT)
    message(FATAL_ERROR "refii_build_id.cmake needs REFII_SOURCE_DIR and REFII_OUTPUT")
endif()

set(build_id "unknown")
find_program(REFII_GIT_EXECUTABLE git)
if(REFII_GIT_EXECUTABLE)
    execute_process(
        COMMAND "${REFII_GIT_EXECUTABLE}" -C "${REFII_SOURCE_DIR}" rev-parse --short=9 HEAD
        OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE sha_result ERROR_QUIET)
    if(sha_result EQUAL 0 AND sha)
        execute_process(
            COMMAND "${REFII_GIT_EXECUTABLE}" -C "${REFII_SOURCE_DIR}" log -1 --format=%cs HEAD
            OUTPUT_VARIABLE date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        # Tracked files only: untracked scratch and build output are not a changed build.
        execute_process(
            COMMAND "${REFII_GIT_EXECUTABLE}" -C "${REFII_SOURCE_DIR}" status --porcelain --untracked-files=no
            OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        set(build_id "${sha}")
        if(dirty)
            string(APPEND build_id "+")
        endif()
        if(date)
            string(APPEND build_id " ${date}")
        endif()
    endif()
endif()

set(content "// Generated by cmake/refii_build_id.cmake at build time. Do not edit.
#pragma once
#define REFII_BUILD_ID \"${build_id}\"
")
file(WRITE "${REFII_OUTPUT}.tmp" "${content}")
configure_file("${REFII_OUTPUT}.tmp" "${REFII_OUTPUT}" COPYONLY)
file(REMOVE "${REFII_OUTPUT}.tmp")
