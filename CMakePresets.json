{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v3",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_CROSS_CONFIGS": "all",
                "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
                "CMAKE_DEFAULT_CONFIGS": "all"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-arm64-base",
            "hidden": true,
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "",
                "CMAKE_CXX_FLAGS": ""
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-20",
                "CMAKE_CXX_COMPILER": "clang++-20"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-arm64-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a"
            }
        },
        {
            "name": "win-amd64-debug-netplay",
            "displayName": "Windows AMD64 Netplay Debug",
            "inherits": "windows-base"
        },
        {
            "name": "win-amd64-release-netplay",
            "displayName": "Windows AMD64 Netplay Release",
            "inherits": "windows-base"
        },
        {
            "name": "win-amd64-relwithdebinfo-netplay",
            "displayName": "Windows AMD64 Netplay RelWithDebInfo",
            "inherits": "windows-base"
        },
        {
            "name": "win-arm64-debug-netplay",
            "displayName": "Windows ARM64 Netplay Debug",
            "inherits": "windows-arm64-base"
        },
        {
            "name": "win-arm64-release-netplay",
            "displayName": "Windows ARM64 Netplay Release",
            "inherits": "windows-arm64-base"
        },
        {
            "name": "win-arm64-relwithdebinfo-netplay",
            "displayName": "Windows ARM64 Netplay RelWithDebInfo",
            "inherits": "windows-arm64-base"
        },
        {
            "name": "linux-amd64-debug-netplay",
            "displayName": "Linux AMD64 Netplay Debug",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-amd64-release-netplay",
            "displayName": "Linux AMD64 Netplay Release",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-amd64-relwithdebinfo-netplay",
            "displayName": "Linux AMD64 Netplay RelWithDebInfo",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "win-amd64-debug-netplay",
            "configurePreset": "win-amd64-debug-netplay",
            "configuration": "Debug"
        },
        {
            "name": "win-amd64-release-netplay",
            "configurePreset": "win-amd64-release-netplay",
            "configuration": "Release"
        },
        {
            "name": "win-amd64-relwithdebinfo-netplay",
            "configurePreset": "win-amd64-relwithdebinfo-netplay",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "win-arm64-debug-netplay",
            "configurePreset": "win-arm64-debug-netplay",
            "configuration": "Debug"
        },
        {
            "name": "win-arm64-release-netplay",
            "configurePreset": "win-arm64-release-netplay",
            "configuration": "Release"
        },
        {
            "name": "win-arm64-relwithdebinfo-netplay",
            "configurePreset": "win-arm64-relwithdebinfo-netplay",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux-amd64-debug-netplay",
            "configurePreset": "linux-amd64-debug-netplay"
        },
        {
            "name": "linux-amd64-release-netplay",
            "configurePreset": "linux-amd64-release-netplay"
        },
        {
            "name": "linux-amd64-relwithdebinfo-netplay",
            "configurePreset": "linux-amd64-relwithdebinfo-netplay"
        }
    ]
}
