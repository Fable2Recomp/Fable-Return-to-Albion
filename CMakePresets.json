            "displayName": "Linux AMD64 Netplay Release",
            "inherits": ["netplay", "linux-base"],
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "linux-amd64-relwithdebinfo-netplay",
            "displayName": "Linux AMD64 Netplay RelWithDebInfo",
            "inherits": ["netplay", "linux-base"],
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        }
    ],
    "buildPresets": [
        { "name": "win-amd64-debug", "configurePreset": "win-amd64-debug", "configuration": "Debug" },
