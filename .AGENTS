│   ├── src/                    # Host engine C# source code
│   │   ├── Engine/             # Core host subsystems
│   │   │   ├── bnk/            # BnkFileSystem, archive reading, virtual mounting
│   │   │   ├── gdb/            # Game Database (GDB) parsing, patching, composting
│   │   │   ├── mods/           # F2ModPackage (.f2mod), load order, manifests, overlays
│   │   │   ├── text/           # Babel text databases and CSV row overlays
