+bool RenderingDeviceDriverVulkan::_respv_stage_spirv(const ShaderInfo::RespvStageCode &p_code, PackedByteArray &r_spirv) {
+	Vector<uint8_t> decompressed;
+	const uint8_t *code = p_code.compressed.ptr();
+	uint32_t code_size = p_code.compressed.size();
+	if (p_code.decompressed_size > 0) {
+		decompressed.resize(p_code.decompressed_size);
+		if (p_code.compression_flags & RenderingShaderContainer::COMPRESSION_FLAG_ZSTD) {
+			if (Compression::decompress(decompressed.ptrw(), p_code.decompressed_size, code, code_size, Compression::MODE_ZSTD) < 0) {
+				return false;
+			}
+		} else {
+			memcpy(decompressed.ptrw(), code, MIN(code_size, p_code.decompressed_size));
+		}
+		code = decompressed.ptr();
+		code_size = decompressed.size();
+	}
+
+	if (p_code.compression_flags & RenderingShaderContainerVulkan::COMPRESSION_FLAG_SMOLV) {
+		r_spirv.resize(smolv::GetDecodedBufferSize(code, code_size));
+		return !r_spirv.is_empty() && smolv::Decode(code, code_size, r_spirv.ptrw(), r_spirv.size());
+	}
+
+	r_spirv.resize(code_size);
+	memcpy(r_spirv.ptrw(), code, code_size);
+	return true;
+}
