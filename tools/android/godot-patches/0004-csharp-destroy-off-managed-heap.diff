 #ifdef __cplusplus
+// The managed side disposes StringName, NodePath, Array, Dictionary and a Variant's disposer through
+// `NativeValue.DangerousSelfRef`: p_self points into the managed object and is not pinned. A
+// compacting GC on another thread can move that object while the destructor runs, and the
+// destructors read the field again after their refcount drop (StringName's after taking the
+// global table lock), so they then see another object's bytes. Read the value once, into native
+// storage, and destroy that copy. Nothing is written back: the caller clears its own field.
+template <typename T>
+static void _destroy_off_managed_heap(T *p_self) {
+	alignas(T) uint8_t storage[sizeof(T)];
+	memcpy(storage, (const void *)p_self, sizeof(T));
+	reinterpret_cast<T *>(storage)->~T();
+}
+
 extern "C" {
 #endif
 
