 using namespace RendererSceneRenderImplementation;
 
+// godot-patches/0017: rendering/renderer/cutout_depth_prepass_mobile, 0 (off) to 2.
+static uint32_t _cutout_depth_prepass_setting() {
+	return uint32_t(CLAMP(GLOBAL_GET_CACHED(int, "rendering/renderer/cutout_depth_prepass_mobile"), 0, 2));
+}
+
+// godot-patches/0017: what the pre-pass drew, logged every 10 s while it runs ("[cutout-prepass]" in logcat).
+static void _cutout_depth_prepass_note(uint32_t p_mode, uint32_t p_depth_draws, uint32_t p_opaque_draws) {
+	static uint64_t window_start = 0;
+	static uint64_t views = 0;
+	static uint64_t depth_draws = 0;
+	static uint32_t most_depth_draws = 0;
+	static uint32_t most_opaque_draws = 0;
+	const uint64_t now = OS::get_singleton()->get_ticks_msec();
+	if (window_start == 0) {
+		window_start = now;
+	}
+	views++;
+	depth_draws += p_depth_draws;
+	if (p_depth_draws > most_depth_draws) {
+		most_depth_draws = p_depth_draws;
+		most_opaque_draws = p_opaque_draws;
+	}
+	if (now - window_start >= 10000) {
+		print_line(vformat("[cutout-prepass] mode %d (%s): %d views drew a depth pre-pass in %.1f s, %.1f depth draws a view; most %d depth draws in one view, of its %d opaque draws",
+				p_mode, p_mode == 2 ? "EQUAL" : "GREATER_OR_EQUAL", views, (now - window_start) / 1000.0, double(depth_draws) / double(views), most_depth_draws, most_opaque_draws));
+		window_start = now;
+		views = 0;
+		depth_draws = 0;
+		most_depth_draws = 0;
+		most_opaque_draws = 0;
+	}
+}
