+	// Under the binding lock too: a worker may be replacing this binding's collected wrapper
+	// (godotsharp_internal_unmanaged_instance_binding_create_managed) or setting it up.
+	MutexLock bind_lock(get_singleton()->language_bind_mutex);
 	MonoGCHandleData &gchandle = r_script_binding.gchandle;
 	if (!gchandle.is_released() && gchandle.get_intptr() == p_gchandle_to_free) { // Do not lock unnecessarily
 		MutexLock lock(get_singleton()->script_gchandle_release_mutex);
@@ -1274,7 +1277,10 @@ GDExtensionBool CSharpLanguage::_instance_binding_reference_callback(void *p_tok
 
 	if (p_reference) {
 		// Refcount incremented
-		if (refcount > 1 && gchandle.is_weak()) { // The managed side also holds a reference, hence 1 instead of 0
+		// Not when the handle is already gone: a swap that found the wrapper collected leaves it
+		// released (and still typed weak), and swapping a released handle throws "Handle is not
+		// initialized" in the managed callback. The next lookup from C# makes a new wrapper.
+		if (refcount > 1 && !gchandle.is_released() && gchandle.is_weak()) { // The managed side also holds a reference, hence 1 instead of 0
 			// The reference count was increased after the managed side was the only one referencing our owner.
 			// This means the owner is being referenced again by the unmanaged side,
